# Editor settings for the whole repo, read by Zed, Neovim (built in), VS Code,
# shfmt and Prettier. Formatters' own configs (.prettierrc, .stylua.toml) decide
# anything they cover; this mainly keeps files no formatter touches consistent.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# git config files are indented with tabs, as git writes them
[{gitconfig,.gitconfig,*.gitconfig}]
indent_style = tab
