{
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "proseWrap": "always",
        "printWidth": 80
      }
    },
    {
      "files": ["*.jsonc", "**/zed/settings.json", ".zed/settings.json"],
      "options": {
        "parser": "jsonc",
        "trailingComma": "all"
      }
    }
  ]
}
