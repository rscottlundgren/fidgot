# Ghostty config
#
# Full reference: `ghostty +show-config --default --docs`
# Check this file: `ghostty +validate-config`
# Reload while running: cmd-shift-, (or restart Ghostty)

# --- Look ---------------------------------------------------------------------

# Atom One matches Zed's One Dark / One Light; follows the macOS appearance.
# Both are tuned copies in themes/: Atom One Dark Bright (brighter text) and
# Atom One Light Deep (darker green/red/yellow), for readability over the
# translucent background, each with a muted mustard selection.
theme = dark:Atom One Dark Bright,light:Atom One Light Deep

# Nerd Font (Mono variant: every icon fits one cell, so icons stay centered).
font-family = CommitMono Nerd Font Mono
font-size = 11

# Taller lines (text stays centered in the taller cells),
# for a little air between the prompt's two lines.
adjust-cell-height = 20%

background-opacity = 0.775
background-blur = false

# Apply the opacity to cells with their own background color too (selections,
# highlighted lines, diff colors, the Starship segments), not just the window.
background-opacity-cells = true

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

# Ghostty's own fullscreen, so the transparency above survives fullscreen
# (native macOS fullscreen turns it off). Enter it with cmd-enter: the green
# button and cmd-ctrl-F still use native (opaque) fullscreen. Tabs don't carry
# over: only the focused tab goes fullscreen, the rest stay in a normal window.
macos-non-native-fullscreen = true

# --- Behavior -----------------------------------------------------------------

mouse-hide-while-typing = true

# --- Shell integration ----------------------------------------------------------

# ssh-terminfo installs Ghostty's terminfo on remote hosts (e.g. EC2), and
# ssh-env falls back to TERM=xterm-256color when that isn't possible, so
# remote shells don't break on the unknown xterm-ghostty.
shell-integration-features = cursor,title,path,ssh-env,ssh-terminfo
