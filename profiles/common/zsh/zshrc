# Interactive shell setup. Linked to ~/.zshrc; see README.md in this folder.
# Machine-specific settings go in ~/.zshrc.local (not tracked), loaded at the end.

command -v starship >/dev/null && eval "$(starship init zsh)"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Homebrew
# Brew Install - Accepts Formula / Cask Name(s) As Parameter(s)
brew-in() {
    brew doctor; brew update; brew upgrade; brew install "$@"; brew cleanup; brew doctor;
}

# Brew Uninstall - Accepts Formula / Cask Name(s) As Parameter(s)
brew-un() {
    brew doctor; brew update; brew upgrade; brew uninstall "$@"; brew cleanup; brew doctor;
}

# Brew Upgrade - No Parameters Needed
brew-up() {
    brew doctor; brew update; brew upgrade; brew cleanup; brew doctor;
}

# 1Password CLI shell plugins (e.g. `aws` through `op plugin run`); the file is
# generated by `op plugin init`, so it stays out of the repo
[ -f "$HOME/.config/op/plugins.sh" ] && source "$HOME/.config/op/plugins.sh"

# Go-installed tools (e.g. the handoff helper from agent-config)
export PATH="$HOME/go/bin:$PATH"

# Added by the Postman CLI installer
export PATH="$HOME/.local/bin:$PATH"

# Machine-specific settings (not tracked)
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
