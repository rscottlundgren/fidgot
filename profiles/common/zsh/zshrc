# shellcheck shell=bash disable=SC1090,SC1091
# (shellcheck reads zsh as bash; every file sourced here only exists at runtime)
# Interactive shell setup. Linked to ~/.zshrc; see README.md in this folder.
# Machine-specific settings go in ~/.zshrc.local (not tracked), loaded last.

# --- Prompt -------------------------------------------------------------------

command -v starship >/dev/null && eval "$(starship init zsh)"

# --- Toolchains & PATH --------------------------------------------------------
# Each PATH addition goes in front of the ones before it, so the last one wins.

# ------ Node (nvm) ----------------------------------------
# nvm itself, then its tab completion

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# ------ Go ------------------------------------------------
# Go-installed tools (e.g. the handoff helper from agent-config)

export PATH="$HOME/go/bin:$PATH"

# ------ Rust ----------------------------------------------
# rustup from Homebrew (its rustc, cargo, rust-analyzer, ... aren't on PATH by
# default), and tools installed with `cargo install`

if [ -d "$HOMEBREW_PREFIX/opt/rustup/bin" ]; then
  export PATH="$HOMEBREW_PREFIX/opt/rustup/bin:$PATH"
fi
if [ -d "$HOME/.cargo/bin" ]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

# ------ Java ----------------------------------------------
# Homebrew's openjdk is keg-only (not linked), so put it on PATH and set
# JAVA_HOME; macOS's /usr/bin/java stub only finds JDKs in /Library/Java

openjdk="$HOMEBREW_PREFIX/opt/openjdk"
if [ -d "$openjdk/libexec/openjdk.jdk" ]; then
  export JAVA_HOME="$openjdk/libexec/openjdk.jdk/Contents/Home"
  export PATH="$openjdk/bin:$PATH"
fi
unset openjdk

# ------ ~/.local/bin --------------------------------------
# Added by the Postman CLI installer

export PATH="$HOME/.local/bin:$PATH"

# --- Tools --------------------------------------------------------------------
# After PATH, so the checks for each command find it.

# ------ 1Password CLI -------------------------------------
# Shell plugins (e.g. `aws` through `op plugin run`); the file is generated by
# `op plugin init`, so it stays out of the repo

[ -f "$HOME/.config/op/plugins.sh" ] && source "$HOME/.config/op/plugins.sh"

# ------ eza -----------------------------------------------
# Directory listings ("eza ls"): folders first, icons, git status. Flags pass
# through: els -l (details), els -la (with dotfiles), els -T -L2 (tree)

if command -v eza >/dev/null; then
  alias els='eza --group-directories-first --icons --git --time-style=relative'
fi

# --- Shell functions ----------------------------------------------------------
# brew-in, brew-un, brew-up, ...: every functions/*.zsh next to this file.
# ~/.zshrc links into the repo, so readlink finds the folder. Written in syntax
# bash also parses, so shellcheck can check this file.

_fidgot_functions() {
  setopt local_options null_glob
  local directory file
  directory="$(dirname "$(readlink "$HOME/.zshrc" || echo "$HOME/.zshrc")")"
  for file in "$directory"/functions/*.zsh; do
        source "$file"
  done
}
_fidgot_functions
unset -f _fidgot_functions

# --- Machine-specific (keep last) ---------------------------------------------
# ~/.zshrc.local isn't tracked; loaded last, so it can override anything above.

[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
