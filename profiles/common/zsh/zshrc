# shellcheck shell=bash
# Interactive shell setup. Linked to ~/.zshrc; see README.md in this folder.
# Machine-specific settings go in ~/.zshrc.local (not tracked), loaded at the end.

# --- Prompt -------------------------------------------------------------------

command -v starship >/dev/null && eval "$(starship init zsh)"

# --- Toolchains and PATH ------------------------------------------------------
# Each PATH addition goes in front of the ones before it, so the last one wins.

export NVM_DIR="$HOME/.nvm"
# shellcheck source=/dev/null
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
# shellcheck source=/dev/null
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Go-installed tools (e.g. the handoff helper from agent-config)
export PATH="$HOME/go/bin:$PATH"

# Rust: rustup from Homebrew (its rustc, cargo, rust-analyzer, ... aren't on
# PATH by default), and tools installed with `cargo install`
[ -d "$HOMEBREW_PREFIX/opt/rustup/bin" ] && export PATH="$HOMEBREW_PREFIX/opt/rustup/bin:$PATH"
[ -d "$HOME/.cargo/bin" ] && export PATH="$HOME/.cargo/bin:$PATH"

# Java: Homebrew's openjdk is keg-only (not linked), so put it on PATH and set
# JAVA_HOME; macOS's /usr/bin/java stub only finds JDKs in /Library/Java
if [ -d "$HOMEBREW_PREFIX/opt/openjdk/libexec/openjdk.jdk" ]; then
  export JAVA_HOME="$HOMEBREW_PREFIX/opt/openjdk/libexec/openjdk.jdk/Contents/Home"
  export PATH="$HOMEBREW_PREFIX/opt/openjdk/bin:$PATH"
fi

# Added by the Postman CLI installer
export PATH="$HOME/.local/bin:$PATH"

# --- Tools --------------------------------------------------------------------
# After PATH, so the checks for each command find it.

# 1Password CLI shell plugins (e.g. `aws` through `op plugin run`); the file is
# generated by `op plugin init`, so it stays out of the repo
# shellcheck source=/dev/null
[ -f "$HOME/.config/op/plugins.sh" ] && source "$HOME/.config/op/plugins.sh"

# Directory listings with eza ("eza ls"): folders first, icons, git status.
# Flags pass through: els -l (details), els -la (with dotfiles), els -T -L2 (tree)
command -v eza >/dev/null && alias els='eza --group-directories-first --icons --git --time-style=relative'

# --- Shell functions ----------------------------------------------------------
# brew-in, brew-un, brew-up, ...: every functions/*.zsh next to this file.
# ~/.zshrc links into the repo, so readlink finds the folder. Written in syntax
# bash also parses, so shellcheck can check this file.

_fidgot_functions() {
  setopt local_options null_glob
  local dir f
  dir="$(dirname "$(readlink "$HOME/.zshrc" || echo "$HOME/.zshrc")")"
  for f in "$dir"/functions/*.zsh; do
    # shellcheck source=/dev/null
    source "$f"
  done
}
_fidgot_functions
unset -f _fidgot_functions

# --- Machine-specific (keep last) ---------------------------------------------
# ~/.zshrc.local isn't tracked; loaded last, so it can override anything above.

# shellcheck source=/dev/null
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
